<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>DevFest Bacolod 2026 - SuperAdmin</title>

    <!-- Browser tab icon -->
    <link rel="icon" type="image/png" href="/IMG/GDGTOP.png?v=2">

    <!-- Page stylesheet -->
    <link rel="stylesheet" href="/CSS/SuperAdmin.css">
    <link rel="stylesheet" href="/CSS/nav.css">
</head>

<body>

    <div class="page">
        <div class="site-shell">

            <!-- Shared navbar -->
            <%- include('partials/nav', { currentPage: 'SuperAdmin.php', isLoggedIn: (typeof isLoggedIn !== 'undefined' ? isLoggedIn : false), sid: (typeof sid !== 'undefined' ? sid : '') }) %>

            <main class="main-content">

                <section class="login-card" aria-labelledby="pageTitle">

                    <div class="card-brand" aria-label="DevFest Bacolod 2026">
                        <img
                            src="/IMG/GDG_LOGO.png"
                            alt="DevFest Logo"
                            class="gdg-logo"
                        >

                        <span class="brand-copy">
                            <span class="brand-name">DevFest</span>
                            <span class="brand-location">Bacolod 2026</span>
                        </span>
                    </div>

                    <h1 id="pageTitle">SuperAdmin Terminal</h1>

                    <p class="subtitle">LOGIN FOR DEVFEST ADMINISTRATORS</p>

                    <form id="adminLoginForm" action="/SuperAdmin.php" method="post">

                        <!-- Admin Username -->
                        <div class="field">
                            <label for="adminUsername">Admin Username</label>

                            <div class="input-wrap">

                                <span class="field-icon" aria-hidden="true">
                                    <svg
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="1.6"
                                    >
                                        <circle cx="12" cy="12" r="10"></circle>
                                        <circle cx="12" cy="9" r="3.2"></circle>
                                        <path d="M5.5 19c.9-3 3.3-4.6 6.5-4.6s5.6 1.6 6.5 4.6"></path>
                                    </svg>
                                </span>

                                <input
                                    id="adminUsername"
                                    name="username"
                                    type="text"
                                    autocomplete="username"
                                    aria-label="Admin Username"
                                    placeholder="Enter admin username"
                                    required
                                >

                            </div>
                        </div>

                        <!-- Admin Password -->
                        <div class="field">
                            <label for="adminPassword">Admin Password</label>

                            <div class="input-wrap">

                                <span class="field-icon" aria-hidden="true">
                                    <svg
                                        viewBox="0 0 24 24"
                                        fill="currentColor"
                                    >
                                        <path d="M17 9h-1V7a4 4 0 0 0-8 0v2H7a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-7a2 2 0 0 0-2-2ZM10 7a2 2 0 1 1 4 0v2h-4V7Zm2 9.8a1.8 1.8 0 1 1 1.8-1.8 1.8 1.8 0 0 1-1.8 1.8Z"></path>
                                    </svg>
                                </span>

                                <input
                                    id="adminPassword"
                                    name="password"
                                    type="password"
                                    autocomplete="current-password"
                                    aria-label="Admin Password"
                                    placeholder="Enter admin password"
                                    required
                                >

                                <button
                                    class="toggle-password"
                                    type="button"
                                    id="toggleAdminPassword"
                                    aria-label="Show password"
                                    title="Show password"
                                >
                                    <svg
                                        id="adminEyeIcon"
                                        viewBox="0 0 24 24"
                                        fill="currentColor"
                                        aria-hidden="true"
                                    >
                                        <path d="M12 5c-5.2 0-9.4 4.5-10.5 6.1a1.5 1.5 0 0 0 0 1.8C2.6 14.5 6.8 19 12 19s9.4-4.5 10.5-6.1a1.5 1.5 0 0 0 0-1.8C21.4 9.5 17.2 5 12 5Zm0 11.2a4.2 4.2 0 1 1 0-8.4 4.2 4.2 0 0 1 0 8.4Zm0-2.3a1.9 1.9 0 1 0 0-3.8 1.9 1.9 0 0 0 0 3.8Z"></path>
                                    </svg>
                                </button>

                            </div>
                        </div>

                        <button class="login-button" type="submit">
                            LOGIN ADMIN
                        </button>

                        <p
                            class="form-message"
                            id="adminFormMessage"
                            role="status"
                            aria-live="polite"
                            style="<%= typeof message !== 'undefined' ? (messageSuccess ? 'color: #1b6837;' : 'color: #ea4335;') : '' %>"
                        >
                            <%= typeof message !== 'undefined' ? message : '' %>
                        </p>

                    </form>
                </section>

                <footer>
                    © 2026 GDG BACOLOD - AI Innovations Team. All Rights Reserved
                </footer>

            </main>

        </div>
    </div>

    <!-- Scripts -->
    <script>
    const adminPasswordInput = document.getElementById('adminPassword');
    const toggleAdminPassword = document.getElementById('toggleAdminPassword');
    const adminEyeIcon = document.getElementById('adminEyeIcon');

    if (toggleAdminPassword && adminPasswordInput && adminEyeIcon) {
      toggleAdminPassword.addEventListener('click', () => {
        const isHidden = adminPasswordInput.type === 'password';
        adminPasswordInput.type = isHidden ? 'text' : 'password';
        toggleAdminPassword.setAttribute('aria-label', isHidden ? 'Hide password' : 'Show password');
        toggleAdminPassword.title = isHidden ? 'Hide password' : 'Show password';
        adminEyeIcon.innerHTML = isHidden
          ? '<path d="M3 2 2 3l4 4C3.5 8.6 1.9 10.5 1.5 11.1a1.5 1.5 0 0 0 0 1.8C2.6 14.5 6.8 19 12 19c1.7 0 3.3-.5 4.7-1.2l3.3 3.3 1-1L3 2Zm9 14.2a4.2 4.2 0 0 1-4.2-4.2c0-.7.2-1.4.5-2l5.7 5.7c-.6.3-1.3.5-2 .5ZM12 5c-1.3 0-2.6.3-3.8.8l2 2A4.2 4.2 0 0 1 16.2 14l2.2 2.2c2.1-1.4 3.6-3.1 4.1-3.9a1.5 1.5 0 0 0 0-1.8C21.4 9.5 17.2 5 12 5Zm0 11.2a4.2 4.2 0 1 1 0-8.4 4.2 4.2 0 0 1 0 8.4Zm0-2.3a1.9 1.9 0 1 0 0-3.8 1.9 1.9 0 0 0 0 3.8Z"></path>'
          : '<path d="M12 5c-5.2 0-9.4 4.5-10.5 6.1a1.5 1.5 0 0 0 0 1.8C2.6 14.5 6.8 19 12 19s9.4-4.5 10.5-6.1a1.5 1.5 0 0 0 0-1.8C21.4 9.5 17.2 5 12 5Zm0 11.2a4.2 4.2 0 1 1 0-8.4 4.2 4.2 0 0 1 0 8.4Zm0-2.3a1.9 1.9 0 1 0 0-3.8 1.9 1.9 0 0 0 0 3.8Z"></path>';
      });
    }

    // Error handling: Prevent Backspace key from navigating back outside inputs
    window.addEventListener('keydown', (event) => {
      if (event.key === 'Backspace' || event.keyCode === 8) {
        const target = event.target;
        const isEditable =
          (target.tagName === 'INPUT' || target.tagName === 'TEXTAREA' || target.isContentEditable) &&
          !target.readOnly &&
          !target.disabled;
        if (!isEditable) {
          event.preventDefault();
        }
      }
    });
    </script>
    <script src="/JAVASCRIPT/nav.js" defer></script>
</body>
</html>
